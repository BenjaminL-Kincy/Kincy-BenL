Exercice 3

a.le chiffre d'affaires total

SELECT SUM (prix * qte) AS Chiffre_affaire_total
FROM ventes

Chiffre_affaire_total : 44825


b.les ventes par produit


SELECT produit, 
SUM (qte) AS chiffre_affaire_total_par_produit
FROM ventes
GROUP BY produit

